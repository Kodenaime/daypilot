PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daypilot?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_here
# TOKEN_ENCRYPTION_KEY must be exactly 32 bytes (64 hex characters or 32 raw characters).
# Generate locally using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_character_hex_token_encryption_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
FCM_SERVICE_ACCOUNT_KEY=your_fcm_service_account_key_base64_encoded_here
RESEND_API_KEY=your_resend_api_key_here
